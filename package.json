{
  "name": "blackboard-mcp",
  "version": "0.2.0",
  "description": "Local-first, read-only Blackboard MCP server for the signed-in student (Syracuse University)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "blackboard-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "login": "node dist/cli/login.js",
    "status": "node dist/cli/status.js",
    "courses": "node dist/cli/courses.js",
    "discover": "node dist/cli/discover.js",
    "logout": "node dist/cli/logout.js",
    "connect": "node dist/cli/connect.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test:watch": "vitest",
    "setup": "npm install --omit=dev --no-fund --no-audit && node dist/cli/setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fflate": "^0.8.3",
    "playwright": "^1.54.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
